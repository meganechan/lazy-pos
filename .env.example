# Copy to .env (gitignored). NEVER commit real secrets.
DATABASE_URL=postgres://lazy:lazy@localhost:5432/lazypos
PORT=8080

# Beam Bolt EDC — real key must be injected from a secret manager / env only.
# Empty credentials use mock mode. Use the adapter's sandbox by default.
BEAM_BOLT_API_BASE=https://playground.api.beamcheckout.com
BEAM_BOLT_MERCHANT_ID=
BEAM_BOLT_API_KEY=
# Base64 webhook signing secret; required for real credentials.
BEAM_WEBHOOK_SECRET=

# LINE Official Account (confirm step + future CRM) — mocked in this demo.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
